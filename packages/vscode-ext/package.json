{
  "name": "twowayflow-vscode",
  "displayName": "twowayflow",
  "description": "Editable dataflow canvas over *.flow.ts files. The code is the only source of truth.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "publisher": "twowayflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpbarbosa/twowayflow.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "twowayflow.openCanvas",
        "title": "twowayflow: Open Flow Canvas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "twowayflow.newDiagramRequest",
        "title": "twowayflow: New Diagram Request",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "twowayflow.openCanvas",
          "when": "resourceFilename =~ /\\.flow\\.ts$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "twowayflow.openCanvas",
          "when": "resourceFilename =~ /\\.flow\\.ts$/"
        }
      ]
    },
    "configuration": {
      "title": "twowayflow",
      "properties": {
        "twowayflow.revealOnCanvasSelect": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the source range in the text editor when a canvas node is selected."
        },
        "twowayflow.diagramRequest.handoff": {
          "type": "string",
          "enum": [
            "terminal",
            "clipboard"
          ],
          "enumDescriptions": [
            "Run `claude '<request>'` in a terminal opened in the project being diagrammed.",
            "Copy the request and open the Claude Code side bar, so you paste it into the session you already have."
          ],
          "default": "terminal",
          "description": "How `twowayflow: New Diagram Request` hands the request to Claude Code. Falls back to the clipboard when `claude` is not on PATH."
        },
        "twowayflow.diagramRequest.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to twowayflow's `scripts/twf-diagram`. Empty means: look for it in the open workspace folders."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "node esbuild.mjs && vsce package --no-dependencies",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --build",
    "build:integration": "node esbuild.mjs --integration",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && node integration/runTests.mjs"
  },
  "dependencies": {
    "@twowayflow/core": "workspace:*",
    "@twowayflow/dsl": "workspace:*",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "@xyflow/react": "12.12.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
